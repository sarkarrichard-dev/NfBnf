# Copy to .env and paste your paid Dhan credentials.
# Do not share .env.
#
# API key flow (dashboard Dhan Login):
#   web.dhan.co → My Profile → Access DhanHQ APIs → API key
#   - DHAN_API_KEY / DHAN_API_SECRET = App ID & secret from that screen
#   - DHAN_CLIENT_ID = your numeric Dhan Client ID (not the API key)
#   - Redirect URL on Dhan: http://127.0.0.1:8000/dhan/oauth/callback
#     (browser lands there after login; token is saved automatically)
#   - Or paste tokenId / JWT manually in the dashboard.

DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_AUTH_BASE_URL=https://auth.dhan.co

# Numeric Client ID from Dhan profile (must match the account that owns the API key / token).
# If you paste an eyJ… JWT, Save Token will auto-fill this from the token.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_TOKEN_EXPIRY=
DHAN_API_BASE_URL=https://api.dhan.co/v2

# Only dashboard control: Paper vs Live (Live also sets ALLOW_LIVE_TRADING=true).
TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false

# Risk limits are hard-coded in index_ai/risk_policy.py (not in .env).

# Underlying security ids. NIFTY example is 13 in Dhan option-chain docs.
# Change these if Dhan's security master says otherwise for your account/feed.
NIFTY_SECURITY_ID=13
BANKNIFTY_SECURITY_ID=25
# Optional override (units per 1 lot). Leave blank to use NSE defaults: NIFTY 65, BANKNIFTY 30.
# Values 75 / 35 are treated as legacy and ignored (auto-corrected to 65 / 30).
# NIFTY_LOT_SIZE=
# BANKNIFTY_LOT_SIZE=

# Hugging Face learning (FinBERT sentiment + outcome dataset export)
# Token: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_SENTIMENT_MODEL=ProsusAI/finbert
# Optional: push memory/hf/outcomes.jsonl to a private dataset repo
# HF_DATASET_REPO=your-username/index-options-outcomes
# HF_USE_LOCAL=false
# HF_MIN_POSITIVE_PROB=0.42

