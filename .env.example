# Copy this file to .env only if you want to add private keys or change risk settings.
# Never share your .env file.

# AI narrator, optional
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Dhan data feed, optional
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_API_BASE_URL=https://api.dhan.co/v2
DHAN_FEED_URL=wss://api-feed.dhan.co

# Safety switch
TRADING_AI_ENABLE_LIVE_TRADING=false
# Set to true to immediately block new paper orders (operator kill switch)
TRADING_AI_KILL_SWITCH=false

# Paper trading settings
TRADING_AI_ENABLE_PAPER_TRADING=true
TRADING_AI_PAPER_STARTING_EQUITY=1000000
TRADING_AI_RISK_PER_TRADE_PCT=0.005
TRADING_AI_MAX_POSITION_PCT=0.10
TRADING_AI_MAX_DAILY_LOSS_PCT=0.02
TRADING_AI_MAX_TRADES_PER_DAY=10
TRADING_AI_MIN_TRADE_CONFIDENCE=0.35
TRADING_AI_MIN_ABS_TRADE_SCORE=0.18
TRADING_AI_DEFAULT_STOP_PCT=0.015
TRADING_AI_REWARD_RISK=2.0

# Optional: extra folders that contain CSV or Excel files to profile
TRADING_AI_EXTRA_DATA_FOLDERS=
