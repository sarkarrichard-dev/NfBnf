# Copy this file to .env only if you want to add private keys or change risk settings.
# Never share your .env file.
#
# Optional: copy trading_ai_engine/local_secrets.example.py to trading_ai_engine/local_secrets.py
# and put API keys there instead; values in .env / the shell still override that file.

# AI narrator, optional
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Dhan data feed, optional
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_API_BASE_URL=https://api.dhan.co/v2
DHAN_FEED_URL=wss://api-feed.dhan.co

# OpenAlgo (self-hosted) — paper routing sends placesmartorder here when execution mode is paper_openalgo
# See https://github.com/marketcalls/openalgo — run OpenAlgo locally (default port 5000) and create an API key.
OPENALGO_BASE_URL=http://127.0.0.1:5000
OPENALGO_API_KEY=
# OPENALGO_STRATEGY=TradingAIML
# TRADING_AI_OPENALGO_PRODUCT=MIS
# TRADING_AI_OPENALGO_FNO_PRODUCT=NRML
# Optional: JSON map for Yahoo ^INDEX → [OpenAlgo symbol, exchange], e.g. {"^MYINDEX":["ROOT","NSE_INDEX"]}
# TRADING_AI_OPENALGO_INDEX_MAP=
# TRADING_AI_OPENALGO_DISABLE=true

# Default execution mode if operator_prefs DB row unset: paper_openalgo | paper_local | live_dhan
# When unset, the app picks paper_openalgo if OPENALGO_API_KEY is set, else paper_local.
# TRADING_AI_EXECUTION_MODE=paper_local

# Optional: TauricResearch/TradingAgents (https://github.com/TauricResearch/TradingAgents) — pip install -e ".[tradingagents]"
# TRADING_AI_TRADINGAGENTS_TIMEOUT_S=120

# Brain default: balanced (daily equity-style) or derivatives_intraday (F&O + sub-daily bars)
TRADING_AI_MARKET_FOCUS=derivatives_intraday

# Local dashboard (uvicorn). If 8000 is busy (WinError 10048), use 8001 here and match the launcher.
TRADING_AI_PORT=8000

# Safety switch
TRADING_AI_ENABLE_LIVE_TRADING=false
# Set to true to immediately block new paper orders (operator kill switch)
TRADING_AI_KILL_SWITCH=false

# CPR + EMA9/21 + candlesticks: desk CPR uses prior **calendar** session day H/L/C (see ml/cpr_ema.py).

# Candlestick AIML: require historical win-rate >= this for firing patterns (multi-TF 5m–3h).
TRADING_AI_PATTERN_MIN_WIN_RATE=0.65
# Set false to disable the pattern gate on paper eligibility (model still embeds pattern features).
TRADING_AI_PATTERN_GATE=true

# Multi-agent brain council (momentum / risk / contrarian → one AI voice). Optional env default when JSON body omits use_brain_council.
TRADING_AI_BRAIN_COUNCIL=false

# Paper trading settings
TRADING_AI_ENABLE_PAPER_TRADING=true
TRADING_AI_PAPER_STARTING_EQUITY=1000000
TRADING_AI_RISK_PER_TRADE_PCT=0.005
TRADING_AI_MAX_POSITION_PCT=0.10
TRADING_AI_MAX_DAILY_LOSS_PCT=0.02
TRADING_AI_MAX_TRADES_PER_DAY=10
TRADING_AI_MIN_TRADE_CONFIDENCE=0.35
TRADING_AI_MIN_ABS_TRADE_SCORE=0.18
TRADING_AI_DEFAULT_STOP_PCT=0.015
TRADING_AI_REWARD_RISK=2.0

# Optional: extra folders that contain CSV or Excel files to profile (SQLite catalog only; not required for brain)
TRADING_AI_EXTRA_DATA_FOLDERS=

# --- Online AIML learning (no local uploads required) ---
# Hugging Face Hub: comma-separated dataset specs. Examples: ag_news  |  namespace/name:config:split
# Use parquet/scriptless datasets on modern `datasets` (legacy script datasets may fail).
TRADING_AI_HF_LEARNING_DATASETS=ag_news
# Optional: higher Hub rate limits / private datasets
HF_TOKEN=
# HUGGING_FACE_HUB_TOKEN=

# Optional: skip specific Yahoo symbols during Indian daily download (comma-separated), e.g. flaky tickers.
# TRADING_AI_SKIP_YAHOO_SYMBOLS=

# Yahoo global cross-asset pack for the brain (comma-separated Yahoo symbols)
TRADING_AI_GLOBAL_CONTEXT_SYMBOLS=^GSPC,SPY,EURUSD=X,USDINR=X,CL=F
TRADING_AI_GLOBAL_CONTEXT_PERIOD=10d
TRADING_AI_GLOBAL_CONTEXT_INTERVAL=1d

# Local SQLite file-catalog digest for the LLM (off unless both are true)
TRADING_AI_ALLOW_LOCAL_FILE_DIGEST_FOR_BRAIN=false

# F&O lot sizes (JSON object, lowercase keys). Merged with built-in defaults for NIFTY/BANKNIFTY etc.
# TRADING_AI_FNO_LOT_MAP={"midcpnifty":75}

# Map brain symbols → Dhan REST LTP body (POST /v2/marketfeed/ltp). Replace security_id with yours from Dhan.
# TRADING_AI_DHAN_LTP_MAP={"^NSEI":{"NSE_INDEX":[26009]}}

# Optional: text/label column names for `trading-ai-train-hf-text` (pip install -e ".[hf_train]")
TRADING_AI_HF_TEXT_COL=text
TRADING_AI_HF_LABEL_COL=label
