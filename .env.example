# Copy to .env and paste your paid Dhan credentials.
# Do not share .env.
#
# API key flow (dashboard Dhan Login):
#   web.dhan.co → My Profile → Access DhanHQ APIs → API key
#   - DHAN_API_KEY / DHAN_API_SECRET = App ID & secret from that screen
#   - DHAN_CLIENT_ID = your numeric Dhan Client ID (not the API key)
#   - Redirect URL on Dhan: http://127.0.0.1:8000/dhan/oauth/callback
#     (browser lands there after login; token is saved automatically)
#   - Or paste tokenId / JWT manually in the dashboard.

DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_AUTH_BASE_URL=https://auth.dhan.co

# Numeric Client ID from Dhan profile (must match the account that owns the API key / token).
# If you paste an eyJ… JWT, Save Token will auto-fill this from the token.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_TOKEN_EXPIRY=
# Auto-renew Dhan token in background when near expiry (WEB tokens only; OAuth tokens need re-login).
AUTO_RENEW_DHAN_TOKEN=true
AUTO_RENEW_THRESHOLD_MINUTES=180
AUTO_RENEW_POLL_SECONDS=300
# Renew once each time the server starts (fresh 24h if token still valid).
RENEW_DHAN_TOKEN_ON_STARTUP=true
# While server is running, also renew once per weekday around this IST time.
DAILY_RENEW_IST=08:00
# Hands-off when laptop was off overnight — enable TOTP on Dhan Web first:
# DHAN_PIN=123456
# DHAN_TOTP_SECRET=paste_base32_secret_from_authenticator_setup
# Set automatically on save: WEB (web.dhan.co JWT, renewable) or OAUTH (login link, not renewable).
DHAN_TOKEN_SOURCE=
# Start NIFTY/BANKNIFTY scanner automatically when the server boots (dashboard Start button optional).
AUTO_START_SCANNER=true
# IST session (restart server after edits)
# PRE_OPEN_ANALYSIS: 9:15–9:30 OI · spot volume · CPR · EMA · entries from 9:30 · flat by 15:15
TRADING_ENTRIES_START=09:30
TRADING_ENTRIES_END=15:15
SQUARE_OFF_TIME=15:15
PRE_OPEN_ANALYSIS_START=09:15
PRE_OPEN_ANALYSIS_END=09:30
DHAN_API_BASE_URL=https://api.dhan.co/v2

# Only dashboard control: Paper vs Live (Live also sets ALLOW_LIVE_TRADING=true).
TRADING_MODE=PAPER
ALLOW_LIVE_TRADING=false
# Dhan order product for index options: INTRADAY (default) or MARGIN
# DHAN_ORDER_PRODUCT_TYPE=INTRADAY
# Short F&O legs (credit spread sell side) default to MARGIN unless set:
# DHAN_SELL_PRODUCT_TYPE=MARGIN
# Seconds to poll Dhan order status after placement (detect REJECTED vs TRADED)
# DHAN_ORDER_CONFIRM_SEC=10

# Risk limits are hard-coded in index_ai/risk_policy.py (not in .env).
# Default lots per trade (1–10); dashboard +/- overrides and saves to memory/.
# LOTS_PER_TRADE=1

# --- Strategy tuning (restart server after changes) ---
# AUTO = dual lane: candlestick BUY + CPR SELL (independent each scan)
# CPR = support/resistance context for selling; candle OHLC S/R for buying
# Intraday spot chart interval for EMA, CPR, Supertrend, and all strategies (Dhan: 1, 5, 15, 25, 60).
CANDLE_INTERVAL_MINUTES=1

STRATEGY_STYLE=AUTO
# Trending CPR → buy calls/puts only; sideways → credit only (no long premium):
AUTO_TREND_BUY_FIRST=true
AUTO_BUY_TRENDING_ONLY=true
# false = credit on trend + sideways (bull put, bear call, iron condor). true = credit sideways only.
AUTO_CREDIT_SIDEWAYS_ONLY=false
# 1m credit entries: last bar volume vs prior-bar average (0.65 = 65% of recent avg minimum).
CREDIT_MIN_VOLUME_RATIO=0.65
CREDIT_VOLUME_LOOKBACK_BARS=20
# Conservative loss-control preset (if AUTO is losing on chop days):
# AUTO_INCLUDE_APEX=false
# REQUIRE_EMA_CROSS_FOR_CREDIT=true
# EXIT_CREDIT_ON_EMA_CROSS_FLIP=false
# CPR_CREDIT_MIN_CONFIDENCE=0.65
# CREDIT_STOP_LOSS_PCT=0.45
# CREDIT_PROFIT_TARGET_PCT=0.40
# ENABLE_PROFIT_TRAIL=false
# CREDIT_SHORT_STRIKE_STEPS=3
# CREDIT_WING_STRIKES=3
# MAX_SIDEWAYS_EMA_SPREAD_PCT=0.05
# ENTRY_CONFIRMATION_BARS=3
# MAX_CPR_ENTRY_EXTENSION_PCT=0.15
# Apex Pivot-Trend (video: Theta Gainers) — set STRATEGY_STYLE=APEX to enable
# APEX_SUPERTREND_PERIOD=7
# APEX_SUPERTREND_MULTIPLIER=3
# APEX_MAX_TRADES_PER_DAY=3
# APEX_ENTRIES_START=09:16
# APEX_NO_ENTRY_AFTER=15:00
# APEX_USE_HEDGED_SPREADS=true
# AUTO: also run Apex Pivot-Trend inside AUTO (set false for EMA/CPR credit only)
# AUTO_INCLUDE_APEX=true
# Spot EMA on index chart (interval set by CANDLE_INTERVAL_MINUTES)
# On 1m: 20/50 ≈ same time window as 8/20 on a 5m chart. On 5m chart use 8/20.
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50
# AUTO: pick Apex / cross / range iron condor / aligned-trend credit each scan (recommended)
AUTO_INTELLIGENT_ROUTING=true
AUTO_INCLUDE_APEX=true
# Execution safety: all entries/exits pass validate_execution_plan + live broker checks (always on)
# When intelligent routing is off: bull put / bear call only on fresh 8/20 cross
REQUIRE_EMA_CROSS_FOR_CREDIT=true
# Close credit when EMA flips against the position (cross or alignment)
EXIT_CREDIT_ON_EMA_CROSS_FLIP=true
# Rare: iron condor on sideways CPR when there is no EMA cross this bar
CREDIT_IRON_CONDOR_WITHOUT_CROSS=false
ENABLE_CREDIT_STRATEGIES=true
# CPR width as % of pivot: narrow → trending, wide → sideways (NIFTY/BANKNIFTY intraday)
CPR_NARROW_WIDTH_PCT=0.35
CPR_WIDE_WIDTH_PCT=0.75
# Hedged credit spreads: short leg distance from ATM (in strike steps) and wing width
CREDIT_SHORT_STRIKE_STEPS=2
CREDIT_WING_STRIKES=2
CPR_CREDIT_MIN_CONFIDENCE=0.58
# Credit spread exits (paper + live): fraction of max profit / max loss
# When ENABLE_PROFIT_TRAIL=true, fixed profit target is skipped (trail only).
CREDIT_PROFIT_TARGET_PCT=0.50
CREDIT_STOP_LOSS_PCT=0.60
# MTM profit trail (buy + credit): no profit cap — trails peak MTM, exits on giveback
ENABLE_PROFIT_TRAIL=true
PROFIT_TRAIL_ARM_RUPEES_PER_LOT=500
PROFIT_TRAIL_GIVEBACK_PCT=0.25
# Directional buy filters (when STRATEGY_STYLE is AUTO or BUY)
REQUIRE_SUPERTREND_ALIGN=true
REQUIRE_BREAKOUT_TAG=true
# On 1m: 5 bars ≈ 5 min confirmation. On 5m chart use 2–3 bars instead.
ENTRY_CONFIRMATION_BARS=3
# Prior range for Break Res/Sup — on 1m use ~90 (90 min); on 5m use ~18–20.
BREAKOUT_LOOKBACK=90
MIN_DIRECTIONAL_EMA_SPREAD_PCT=0.03
# 0 disables "too extended from CPR" blocking; set e.g. 0.75 to avoid late chase entries.
MAX_CPR_ENTRY_EXTENSION_PCT=0
# Iron condor/range guard: skip sideways credit when EMA spread is already trending.
MAX_SIDEWAYS_EMA_SPREAD_PCT=0.08
# On 1m: ~30 bars ≈ 30 min ST window (10 bars on 5m chart). On 5m use 10.
SUPERTREND_PERIOD=30
SUPERTREND_MULTIPLIER=3.0
EXIT_ON_SUPERTREND_FLIP=true

# Recent-loss protection: blocks repeating the same index + setup after poor outcomes.
LOSS_GUARD_ENABLED=true
LOSS_GUARD_MIN_TRADES=3
LOSS_GUARD_MAX_LOSS_RATE=0.67
LOSS_GUARD_CONSECUTIVE_LOSSES=2
LOSS_GUARD_LOOKBACK_TRADES=120

# Underlying security ids. NIFTY example is 13 in Dhan option-chain docs.
# Change these if Dhan's security master says otherwise for your account/feed.
NIFTY_SECURITY_ID=13
BANKNIFTY_SECURITY_ID=25
# SENSEX on Dhan IDX_I — security id 51 (BSE INDEX row in api-scrip-master.csv)
SENSEX_SECURITY_ID=51
# Optional override (units per 1 lot). Leave blank to use NSE defaults: NIFTY 65, BANKNIFTY 30.
# Values 75 / 35 are treated as legacy and ignored (auto-corrected to 65 / 30).
# NIFTY_LOT_SIZE=
# BANKNIFTY_LOT_SIZE=

# Hugging Face learning (FinBERT sentiment + outcome dataset export)
# Token: https://huggingface.co/settings/tokens
HF_TOKEN=
HF_SENTIMENT_MODEL=ProsusAI/finbert
# HF Bucket (Buckets UI — sync memory/hf/ on Upload to Hub):
# HF_BUCKET=SarkarRichard/Bnf
# Optional classic dataset repo (same name is fine; bucket and dataset are separate on HF):
# HF_DATASET_REPO=your-username/index-options-outcomes
# HF_USE_LOCAL=false
# HF_MIN_POSITIVE_PROB=0.42
